{
  "name": "dsh-cordis-devtools",
  "version": "0.3.0",
  "description": "Runtime inspector and event profiler for DeepSeek Harness / Cordis.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:web": "node e2e/dsh-web-smoke.mjs",
    "check": "pnpm typecheck && pnpm test",
    "verify:notes": "node scripts/verify-agent-notes.mjs",
    "verify:note-required": "node scripts/verify-note-required.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:policy": "pnpm verify:notes && pnpm verify:links && pnpm verify:note-required",
    "verify:client-bundle": "node scripts/verify-client-bundle.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "devtools",
    "profiler",
    "plugin"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wang-kaopu/dsh-cordis-devtools.git"
  },
  "homepage": "https://github.com/wang-kaopu/dsh-cordis-devtools",
  "bugs": {
    "url": "https://github.com/wang-kaopu/dsh-cordis-devtools/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.32.0",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0"
}
